<launch>

  <arg name="video_device" default="/dev/video4"/>
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <arg name="model_path" default="$(find juno_sketch_tutor)/models/drawing_classifier.h5"/>
  <arg name="classes_path" default="$(find juno_sketch_tutor)/config/classes.txt"/>
  <arg name="language" default="en-US"/>
  <arg name="energy_threshold" default="300"/>
  <arg name="pause_threshold" default="0.8"/>
  <arg name="phrase_time_limit" default="5"/>
  <arg name="listen_timeout" default="8"/>
  <!-- Google STT uploads captured speech; disabled unless explicitly enabled. -->
  <arg name="allow_cloud_stt" default="false"/>
  <arg name="debug_dir" default=""/>

  <!-- USB Camera Node -->
  <node name="usb_cam" pkg="usb_cam" 
        type="usb_cam_node" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="480"/>
    <param name="pixel_format" value="yuyv"/>
    <param name="color_format" value="yuv422p"/>
    <param name="camera_frame_id" value="usb_cam"/>
    <param name="io_method" value="mmap"/>
  </node>

  <!-- Camera View Window -->
  <node name="image_view" pkg="image_view" 
        type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_raw"/>
    <param name="autosize" value="true"/>
  </node>

  <!-- Sketch Game Node -->
  <node pkg="juno_sketch_tutor"
        type="sketch_game_node.py"
        name="sketch_game_node"
        output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="model_path" value="$(arg model_path)"/>
    <param name="classes_path" value="$(arg classes_path)"/>
    <param name="use_espeak" value="true"/>
    <param name="debug_dir" value="$(arg debug_dir)"/>
  </node>

  <!-- Voice Command Node -->
  <node pkg="juno_sketch_tutor"
        type="voice_natural_command_node.py"
        name="voice_natural_command_node"
        output="screen">
    <param name="command_topic" value="/game_command"/>
    <param name="language" value="$(arg language)"/>
    <param name="energy_threshold" value="$(arg energy_threshold)"/>
    <param name="pause_threshold" value="$(arg pause_threshold)"/>
    <param name="phrase_time_limit" value="$(arg phrase_time_limit)"/>
    <param name="listen_timeout" value="$(arg listen_timeout)"/>
    <param name="allow_cloud_stt" value="$(arg allow_cloud_stt)"/>
  </node>

</launch>
